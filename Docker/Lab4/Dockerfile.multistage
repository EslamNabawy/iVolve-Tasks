# ---------- stage 1: build ----------
# The full JDK + Maven live only here; they never reach the final image.
FROM maven:3.9.15-eclipse-temurin-17-alpine AS build

# Java prefers IPv6 when both are advertised; on some networks that path stalls.
ENV MAVEN_OPTS="-Djava.net.preferIPv4Stack=true"

WORKDIR /build

COPY pom.xml .
COPY src ./src

# The dependency cache is a BuildKit cache mount: it survives rebuilds but is
# NOT part of the image, so it contributes nothing to the final size.
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -DskipTests package

# ---------- stage 2: runtime ----------
# JRE only: nothing here can compile code.
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Non-root: the app has no reason to be root, and a compromised app should not be either.
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=build --chown=appuser:appgroup /build/target/demo-0.0.1-SNAPSHOT.jar app.jar

USER appuser
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
