# Remediated image: current LTS base, current express, reproducible install,
# non-root runtime, no package managers left behind, and a health check.
FROM node:24-alpine

ENV NODE_ENV=production

WORKDIR /app

# package.json + lockfile first: cached until dependencies actually change.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# npm, npx, corepack and the bundled Yarn are BUILD-time tools. The container
# starts `node app.js`, so shipping them only adds attack surface: their own
# bundled dependencies are what the first scan flagged.
RUN rm -rf /usr/local/lib/node_modules/npm \
           /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /opt/yarn-*

COPY --chown=node:node app.js ./

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/health || exit 1

CMD ["node", "app.js"]
